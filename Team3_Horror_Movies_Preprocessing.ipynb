        ")\n",
        "plt.title('Missing Value Percentage Before Handling')\n",
        "plt.xlabel('Columns')\n",
        "plt.ylabel('Missing Percentage (%)')\n",
        "plt.xticks(rotation=45, ha='right')\n",
        "plt.tight_layout()\n",
        "plt.show()"
