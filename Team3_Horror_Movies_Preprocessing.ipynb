    {
      "cell_type": "code",
      "source": [
        "for col in numeric_features:\n",
        "    Q1 = df[col].quantile(0.25)\n",
        "    Q3 = df[col].quantile(0.75)\n",
        "    IQR = Q3 - Q1\n",
        "\n",
        "    lower = Q1 - 1.5 * IQR\n",
        "    upper = Q3 + 1.5 * IQR\n",
        "\n",
        "    outliers = ((df[col] < lower) | (df[col] > upper)).sum()\n",
        "\n",
        "    print(f\"{col}: {outliers} outliers\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "2JCefpfzILzU",
